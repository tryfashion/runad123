# Local development only. Never commit .env or real credentials.
MYSQL_URL=mysql://runad_app:CHANGE_ME@127.0.0.1:3306/runad123
AUTH_SECRET=
WEB_ORIGIN=http://127.0.0.1:3000
CHROME_EXTENSION_IDS=
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
TRUSTED_CLIENT_IP_HEADER=
WORKER_HEARTBEAT_MS=15000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI model/prices/budget live in settings.ai_risk, disabled by migration.
# Configure explicitly with ai:configure; do not enable without verified model/prices.
AI_MODEL=
AI_PRICING_VERSION=
AI_INPUT_PER_MILLION=
AI_OUTPUT_PER_MILLION=
AI_DAILY_BUDGET=
AI_INPUT_TOKEN_BUDGET=90000
AI_OUTPUT_TOKENS=4096
AI_CONTEXT_TOKENS=100000

# Optional rewrite output cap. Rewriting shares the ai_risk global daily USD budget.
AI_REWRITE_OUTPUT_TOKENS=8192
