# Production / temporary domain example for ads.zhouerp.com.
# Copy this file to .env on the server and replace every CHANGE_ME value.
# Never commit the real .env.

NODE_ENV=production
MYSQL_URL=mysql://runad_app:CHANGE_ME@127.0.0.1:3306/runad123
AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
WEB_ORIGIN=https://ads.zhouerp.com

# After loading the release Chrome extension, put its exact ID here.
# Multiple IDs are comma-separated, no spaces.
CHROME_EXTENSION_IDS=

# Keep email disabled for the first temporary deployment unless SMTP is ready.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `pnpm run admin:bootstrap`; remove or clear after initializing if desired.
ADMIN_EMAIL=admin@runad123.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_8_PLUS

# If Baota/Nginx forwards client IP through a trusted header, configure only after confirming proxy rules.
TRUSTED_CLIENT_IP_HEADER=
WORKER_HEARTBEAT_MS=15000

# AI stays disabled unless explicitly configured later.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=
AI_PRICING_VERSION=
AI_INPUT_PER_MILLION=
AI_OUTPUT_PER_MILLION=
AI_DAILY_BUDGET=
AI_INPUT_TOKEN_BUDGET=90000
AI_OUTPUT_TOKENS=4096
AI_CONTEXT_TOKENS=100000
AI_REWRITE_OUTPUT_TOKENS=8192

# Local preview must stay off on the server.
LOCAL_PREVIEW_ENABLED=false
